<UserControl x:Class="UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:Core.Enums;assembly=Core"
             xmlns:behaviors="clr-namespace:UI.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="800"
             Background="{DynamicResource MainBackgroundBrush}">

    <UserControl.Resources>
        <!-- MODERN CHECKBOX - NOW FULLY THEMED -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                                    Width="20" Height="20"
                                    CornerRadius="6"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 4,10 L 8,14 L 16,6"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="3"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Opacity="0"
                                      Stretch="Fill"
                                      Width="12" Height="12"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NEON FLAT COMBOBOX - NOW USING DYNAMIC RESOURCES -->
        <Style x:Key="NeonFlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"/>
                                    <Path x:Name="Arrow"
                                          Data="M 0,0 L 6,6 L 12,0 Z"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Width="10" Height="6"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,14,0"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Padding="4" BorderThickness="0">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!-- Normal hover + keyboard focus = use global hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>

                                        <!-- Selected (no hover) -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItem.SelectedBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ComboBoxItem.SelectedForeground}"/>
                                        </Trigger>

                                        <!-- Selected + Hover = special state -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItem.SelectedHoverBackground}"/>
                                        </MultiTrigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EDITABLE NEON COMBOBOX - supports free text entry alongside the dropdown list -->
        <Style x:Key="EditableNeonComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource NeonFlatComboBoxStyle}">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Visibility="Collapsed"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="{TemplateBinding Padding}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             BorderThickness="0"
                                             Focusable="True"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                    <Path x:Name="Arrow"
                                          Data="M 0,0 L 6,6 L 12,0 Z"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Width="10" Height="6"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,14,0"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Padding="4" BorderThickness="0">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMPACT ICON BUTTON - for inline row actions (reorder / remove) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACCENT BUTTON -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,20,0">

                <!-- GENERAL -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="General" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Start with Windows"
                                  Margin="0,0,0,12"/>

                        <CheckBox IsChecked="{Binding MinimizeToTrayOnStartup, Mode=TwoWay}"
                                  IsEnabled="{Binding StartWithWindows}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Minimize to system tray on startup"
                                  Margin="0,0,0,12"/>

                        <CheckBox IsChecked="{Binding RunInBackground, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Keep running when window is closed"
                                  Margin="0,0,0,12"/>

                        <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Minimizing the application minimizes it to tray"/>
                    </StackPanel>
                </Border>

                <!-- APPEARANCE -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Appearance" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Theme" Foreground="{DynamicResource TextMutedBrush}"
                                       Width="140" VerticalAlignment="Center"/>
                            <ComboBox Width="200"
                                      Style="{StaticResource NeonFlatComboBoxStyle}"
                                      SelectedValue="{Binding Theme, Mode=TwoWay}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="System"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- UPDATES SECTION -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="10"
                    Padding="24"
                    Margin="0,0,0,24"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="Updates"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                        <!-- Frequency -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Check for updates automatically"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                            <ComboBox Width="240"
                                 Height="40"
                                 Style="{StaticResource NeonFlatComboBoxStyle}"
                                 SelectedValue="{Binding UpdateFrequency, Mode=TwoWay}"
                                 SelectedValuePath="Tag">
                                
                                <ComboBoxItem Content="Every time the app starts" Tag="{x:Static enums:UpdateFrequency.OnLaunch}"/>
                                <ComboBoxItem Content="Daily" Tag="{x:Static enums:UpdateFrequency.Daily}"/>
                                <ComboBoxItem Content="Weekly" Tag="{x:Static enums:UpdateFrequency.Weekly}"/>
                                <ComboBoxItem Content="Never" Tag="{x:Static enums:UpdateFrequency.Never}"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="Check for Updates Now"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="OnCheckForUpdatesNowClick"
                            Margin="0,0,0,16"/>

                        <!-- Status text + changelog - hidden when no update -->
                        <StackPanel Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,12">
                            <TextBlock Text="A new update is available, update now to experience the newest features!"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding LatestChangelogText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Big accent button - hidden when no update -->
                        <Button Height="44"
                            MinWidth="240"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Update Now"
                            FontWeight="Bold"
                            FontSize="13"
                            Click="OnUpdateButtonClick"
                            Margin="0,12,0,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- DROPS BEHAVIOR -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Drops Behavior" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox IsChecked="{Binding AutoClaimRewards, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Auto-claim rewards when ready"
                                  Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="Mining priority" Foreground="{DynamicResource TextMutedBrush}"
                                       Width="140" VerticalAlignment="Center"/>
                            <ComboBox Width="260"
                                      Style="{StaticResource NeonFlatComboBoxStyle}"
                                      SelectedValue="{Binding MiningPriorityMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Ending Soonest" Tag="{x:Static enums:MiningPriorityMode.EndingSoonest}"/>
                                <ComboBoxItem Content="Live Now First" Tag="{x:Static enums:MiningPriorityMode.LiveNowFirst}"/>
                                <ComboBoxItem Content="Highest Completion of Drop" Tag="{x:Static enums:MiningPriorityMode.HighestCompletionOfDrop}"/>
                                <ComboBoxItem Content="Least Time To Next Reward" Tag="{x:Static enums:MiningPriorityMode.LeastTimeToNextReward}"/>
                            </ComboBox>

                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    Margin="10,0,0,0"
                                    Cursor="Help">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="360">
                                            <TextBlock FontWeight="Bold" Margin="0,0,0,6" Text="Ending Soonest"/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Text="Whichever campaign expires the soonest gets priority - so time-limited drops finish before they run out, even if another campaign is further along."/>

                                            <TextBlock FontWeight="Bold" Margin="0,0,0,6" Text="Live Now First"/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Text="Checks whether the specific streamer(s) required for a drop are actually live right now, and prioritizes campaigns that are confirmed live over ones that aren't."/>

                                            <TextBlock FontWeight="Bold" Margin="0,0,0,6" Text="Highest Completion of Drop"/>
                                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Text="Keeps watching whichever campaign's current reward is furthest along - e.g. Rust already at 50% keeps priority over Tarkov at 20%, even if Tarkov ends sooner."/>

                                            <TextBlock FontWeight="Bold" Margin="0,0,0,6" Text="Least Time To Next Reward"/>
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Prioritizes whichever campaign needs the fewest more minutes to finish its next reward - e.g. a Rust drop needing 1 more hour beats an Overwatch drop needing 2 more hours, regardless of percentage."/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Text="i" FontWeight="Bold" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GAME FILTERING -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Game Filtering" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="If no games are selected, all games are allowed."
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Twitch" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TwitchWhitelistSummary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource MainBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,0,0,6">
                            <ListBox ItemsSource="{Binding TwitchGameFilterOptions}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxHeight="140"
                                     behaviors:ScrollBubbling.PassThrough="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  Margin="0,4,0,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <CheckBox Content="Blacklist selected games (mine everything except these)"
                                  IsChecked="{Binding TwitchGameFilterBlacklist, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Margin="0,0,0,8"/>
                        <Button Content="Clear Twitch whitelist"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnClearTwitchWhitelistClick"
                                Margin="0,0,0,12"/>

                        <TextBlock Text="Kick" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding KickWhitelistSummary}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource MainBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,0,0,6">
                            <ListBox ItemsSource="{Binding KickGameFilterOptions}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxHeight="140"
                                     behaviors:ScrollBubbling.PassThrough="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  Margin="0,4,0,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <CheckBox Content="Blacklist selected games (mine everything except these)"
                                  IsChecked="{Binding KickGameFilterBlacklist, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Margin="0,0,0,8"/>
                        <Button Content="Clear Kick whitelist"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnClearKickWhitelistClick"/>
                    </StackPanel>
                </Border>

                <!-- PRIORITY QUEUE -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding PriorityQueueEnabled, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  FontSize="18" FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Content="Priority Queue"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="When enabled, the first listed game with an available drop always starts before anything else, regardless of mining priority. Reorder with the arrows - top is highest priority."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <StackPanel IsEnabled="{Binding PriorityQueueEnabled}"
                                    Opacity="{Binding PriorityQueueEnabled, Converter={StaticResource BooleanToOpacityConverter}}">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ComboBox x:Name="PriorityGameComboBox"
                                          Width="260"
                                          Height="40"
                                          Style="{StaticResource EditableNeonComboBoxStyle}"
                                          ItemsSource="{Binding KnownGameNames}"
                                          Margin="0,0,12,0"
                                          KeyDown="OnPriorityGameComboBoxKeyDown"/>
                                <Button Content="Add"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="40" MinWidth="90"
                                        Click="OnAddPriorityQueueGameClick"/>
                            </StackPanel>
                            <TextBlock Text="Pick a suggestion or type any game name exactly as it appears on the campaign, then click Add."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource MainBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <ListBox ItemsSource="{Binding PriorityQueueGames}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         MaxHeight="260"
                                         behaviors:ScrollBubbling.PassThrough="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,4,4,4" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1" Tag="{Binding}"
                                                        Click="OnMovePriorityQueueGameUpClick"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Margin="0,0,6,0"
                                                        ToolTip="Move up (higher priority)">
                                                    <Path Data="M 3,8 L 7,4 L 11,8"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>
                                                </Button>
                                                <Button Grid.Column="2" Tag="{Binding}"
                                                        Click="OnMovePriorityQueueGameDownClick"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Margin="0,0,6,0"
                                                        ToolTip="Move down (lower priority)">
                                                    <Path Data="M 3,4 L 7,8 L 11,4"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"/>
                                                </Button>
                                                <Button Grid.Column="3" Tag="{Binding}"
                                                        Click="OnRemovePriorityQueueGameClick"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="Remove">
                                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                                          Stroke="{DynamicResource DangerBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- NOTIFICATIONS -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Notifications" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox IsChecked="{Binding NotifyOnReadyToClaim, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Drop ready to claim (only if auto-claim is off)"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding AutoClaimRewards, Converter={StaticResource InverseBooleanConverter}}"/>

                        <CheckBox IsChecked="{Binding NotifyOnAutoClaimed, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Drop successfully auto-claimed (only if auto-claim is on)"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding AutoClaimRewards}"/>

                        <CheckBox IsChecked="{Binding NotifyOnNewUpdateAvailable, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="New update is available"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding IsUpdateNotificationEnabled}"/>

                        <CheckBox IsChecked="{Binding NotifyOnDropStarted, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="A drop has started being farmed"/>
                    </StackPanel>
                </Border>

                <!-- LOGS -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Logs"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Open the folder containing diagnostic logs for support tickets."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13" Margin="0,0,0,12"/>

                        <Border Background="{DynamicResource MainBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding VerboseDebugLogging, Mode=TwoWay}"
                                          Style="{StaticResource ModernCheckBoxStyle}"
                                          Content="Verbose debug logging"
                                          Margin="0,0,0,6"/>
                                <TextBlock Text="Adds detailed miner + reward percentage trace logs. Enable only while troubleshooting."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="32,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Open Logs Folder"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnOpenLogsFolderClick"/>
                    </StackPanel>
                </Border>

                <!-- DANGER ZONE -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Margin="0,0,0,24"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Accounts"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="DANGER ZONE"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="16" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="Permanently delete ALL logged-in accounts from this device"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Remove ALL Accounts"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                FontWeight="SemiBold"
                                Padding="28,14"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Click="OnRemoveAllAccountsButtonClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- COMING SOON -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="10" Padding="24" Opacity="0.5"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Your ideas could be here! (coming soon)"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="16" FontStyle="Italic" Margin="0,0,0,8"/>
                        <TextBlock Text="Drop your suggestions, to have them implemented here"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>