<UserControl x:Class="UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000"
             Background="{DynamicResource MainBackgroundBrush}">

    <UserControl.Resources>
        <!-- Slim progress bar using PercentToWidthConverter -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ActualWidth" ElementName="Root"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Small ghost icon button, e.g. the manual refresh action -->
        <Style x:Key="RefreshIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- ── PAGE TITLE ── -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Dashboard"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Live drops mining overview"
                           FontSize="13" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- ── STAT CARDS ── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MINER STATUS -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MINER STATUS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource RefreshIconButtonStyle}"
                                    Click="OnRefreshNowClick"
                                    ToolTip="Refresh drops now">
                                <Path Data="M 1,6 A 5,5 0 1 1 3,9.5 M 1,3 L 1,6 L 4,6"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding MinerStatus, FallbackValue='Idle'}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding MinerStatusDetails, FallbackValue='Waiting...'}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- TWITCH STATUS -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource TwitchBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="TWITCH" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding TwitchConnectionColor, FallbackValue=Red}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding TwitchConnectionStatus, FallbackValue='Disconnected'}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="2" HorizontalAlignment="Left">
                            <!-- Login state -->
                            <Button x:Name="TwitchLoginButton"
                                    Content="Login Twitch"
                                    Height="30" HorizontalAlignment="Left"
                                    Padding="14,0" FontWeight="SemiBold" FontSize="12"
                                    Cursor="Hand" Click="OnTwitchLoginClick">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TwitchConnectionStatus}" Value="Connected">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#9146FF" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextBlock.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#A970FF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#772CE8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Connected state -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TwitchConnectionStatus}" Value="Connected">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Height="30" CornerRadius="8" Padding="14,0"
                                        Background="{DynamicResource SurfaceMutedBrush}">
                                    <TextBlock Text="Logged in" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <Button Height="30" Margin="6,0,0,0" Padding="10,0"
                                        FontSize="11" Cursor="Hand" Click="OnTwitchLoginClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource SurfaceHoverBrush}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="↺ "/>
                                                    <Run Text="Reconnect"/>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KICK STATUS -->
                <Border Grid.Column="4"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource KickBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="KICK" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding KickConnectionColor, FallbackValue=Red}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding KickConnectionStatus, FallbackValue='Disconnected'}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="2" HorizontalAlignment="Left">
                            <!-- Login state -->
                            <Button x:Name="KickLoginButton"
                                    Content="Login Kick"
                                    Height="30" HorizontalAlignment="Left"
                                    Padding="14,0" FontWeight="SemiBold" FontSize="12"
                                    Cursor="Hand" Click="OnKickLoginClick">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KickConnectionStatus}" Value="Connected">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#2D9D78" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextBlock.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#34B48F"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#257A63"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Connected state -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KickConnectionStatus}" Value="Connected">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Height="30" CornerRadius="8" Padding="14,0"
                                        Background="{DynamicResource SurfaceMutedBrush}">
                                    <TextBlock Text="Logged in" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <Button Height="30" Margin="6,0,0,0" Padding="10,0"
                                        FontSize="11" Cursor="Hand" Click="OnKickLoginClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource SurfaceHoverBrush}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="↺ "/>
                                                    <Run Text="Reconnect"/>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── CAMPAIGN PROGRESS CARDS ── -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TWITCH CAMPAIGN CARD -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource TwitchBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Twitch Progress" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="CAMPAIGN" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding TwitchCampaignName, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Width="28" Height="36" CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceMutedBrush}" Margin="0,0,10,0"
                                    Visibility="{Binding TwitchCampaignImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                <Image local:ImageEx.SourceUrl="{Binding TwitchCampaignImageUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding TwitchCampaignName}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <ProgressBar Value="{Binding TwitchCampaignProgress}" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TwitchCampaignProgress, StringFormat='{}{0}% complete'}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="CURRENT DROP" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding TwitchDropName, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceMutedBrush}" Margin="0,0,10,0"
                                    Visibility="{Binding TwitchDropImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                <Image local:ImageEx.SourceUrl="{Binding TwitchDropImageUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding TwitchDropName}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding TwitchDropProgress}" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TwitchDropProgress, StringFormat='{}{0}% complete'}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <TextBlock FontSize="12"
                                   Visibility="{Binding TwitchWatchedChannel, Converter={StaticResource StringToVisibilityConverter}}">
                            <Run Text="Watching " Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run Text="{Binding TwitchWatchedChannel}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TwitchBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding TwitchExpiryText}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding TwitchExpiryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TwitchExpiryIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#FFCB8E3A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TwitchExpiryIsCritical}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KICK CAMPAIGN CARD -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource KickBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Kick Progress" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="CAMPAIGN" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding KickCampaignName, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Width="28" Height="36" CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceMutedBrush}" Margin="0,0,10,0"
                                    Visibility="{Binding KickCampaignImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                <Image local:ImageEx.SourceUrl="{Binding KickCampaignImageUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding KickCampaignName}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <ProgressBar Value="{Binding KickCampaignProgress}" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding KickCampaignProgress, StringFormat='{}{0}% complete'}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                        <TextBlock Text="CURRENT DROP" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding KickDropName, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceMutedBrush}" Margin="0,0,10,0"
                                    Visibility="{Binding KickDropImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                <Image local:ImageEx.SourceUrl="{Binding KickDropImageUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding KickDropName}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding KickDropProgress}" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding KickDropProgress, StringFormat='{}{0}% complete'}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <TextBlock FontSize="12"
                                   Visibility="{Binding KickWatchedChannel, Converter={StaticResource StringToVisibilityConverter}}">
                            <Run Text="Watching " Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run Text="{Binding KickWatchedChannel}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource KickBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding KickExpiryText}" FontSize="11" Margin="0,6,0,0"
                                   Visibility="{Binding KickExpiryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KickExpiryIsWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#FFCB8E3A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KickExpiryIsCritical}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── DROPS QUEUE ── -->
            <Border Grid.Row="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,18">
                <StackPanel>

                    <!-- Queue title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="DROPS QUEUE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text=" — drag ⠿ to reorder · click circle to activate"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- WATCHING section header -->
                    <Button Click="OnToggleWatchingSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="0" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWatchingExpanded}" Value="True">
                                                                <Setter Property="Text" Value="▼"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="WATCHING ({0})">
                                                        <Binding Path="WatchingCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource BorderBrush}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- WATCHING items -->
                    <ItemsControl ItemsSource="{Binding WatchingItems}"
                                  Visibility="{Binding IsWatchingExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  PreviewMouseMove="OnQueueMouseMove"
                                  PreviewMouseLeftButtonUp="OnQueueMouseUp">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" CornerRadius="10" Cursor="SizeAll"
                                        ClipToBounds="True"
                                        PreviewMouseLeftButtonDown="OnCardMouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"      Value="{DynamicResource SurfaceHoverBrush}"/>
                                            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Opacity"         Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background"  Value="{DynamicResource SurfaceMutedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                    <Setter Property="Opacity"     Value="0.08"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Platform color strip -->
                                        <Rectangle Grid.Column="0">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{DynamicResource TwitchBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Platform}" Value="Kick">
                                                            <Setter Property="Fill" Value="{DynamicResource KickBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <!-- Drag grip indicator (visual only) -->
                                        <TextBlock Grid.Column="1" Text="⠿" FontSize="14"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" Opacity="0.5"/>

                                        <!-- Card content -->
                                        <StackPanel Grid.Column="2" Margin="0,12,14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Radio + game image -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Button Tag="{Binding}" Click="OnActivateCampaignClick" Cursor="Hand"
                                                            Focusable="False" Width="20" Height="20" Margin="0,0,8,0" Padding="0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid Width="16" Height="16">
                                                                    <Ellipse Width="16" Height="16" Fill="Transparent" StrokeThickness="1.5">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Stroke" Value="{DynamicResource TwitchBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Platform}" Value="Kick">
                                                                                        <Setter Property="Stroke" Value="{DynamicResource KickBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <Ellipse Width="8" Height="8"
                                                                             Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="{DynamicResource TwitchBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Platform}" Value="Kick">
                                                                                        <Setter Property="Fill" Value="{DynamicResource KickBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Border Width="26" Height="34" CornerRadius="4" ClipToBounds="True"
                                                            Background="{DynamicResource SurfaceMutedBrush}"
                                                            Visibility="{Binding GameImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <Image local:ImageEx.SourceUrl="{Binding GameImageUrl}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Name + game + stream status -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding GameName}" FontSize="11" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ExpiryText}" FontSize="10" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExpiryIsWarning}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFCB8E3A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ExpiryIsCritical}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Per-streamer status list (non-general drops with a fixed streamer list) -->
                                                    <ItemsControl ItemsSource="{Binding DisplayedStreamers}" Margin="0,4,0,0"
                                                                  Visibility="{Binding HasSpecificStreamers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOnlineTrue}" Value="True">
                                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsOnlineFalse}" Value="True">
                                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOnlineTrue}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value=""/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOnlineTrue}" Value="True">
                                                                                        <Setter Property="Text" Value="· online"/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsOnlineFalse}" Value="True">
                                                                                        <Setter Property="Text" Value="· offline"/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                                                                        <Setter Property="Text" Value="· online"/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,2,0,0" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Text="{Binding HiddenStreamerCount, StringFormat='+{0} more'}"
                                                               Visibility="{Binding HasHiddenStreamers, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <!-- General drop: single-line watching / searching indicator -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                                Visibility="{Binding StreamChannel, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock FontSize="11" VerticalAlignment="Center">
                                                            <Run Text="Watching " Foreground="{DynamicResource TextMutedBrush}"/>
                                                            <Run Text="{Binding StreamChannel}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                                Visibility="{Binding IsStreamOffline, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Ellipse Width="6" Height="6" Fill="#FFFF8C00" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Searching for stream..." FontSize="11" Foreground="#FFFF8C00" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                                Visibility="{Binding WasSkippedOffline, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Ellipse Width="6" Height="6" Fill="#FFCB8E3A" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="All streamers offline · will retry automatically" FontSize="11" Foreground="#FFCB8E3A" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- × remove -->
                                                <Button Grid.Column="2" Tag="{Binding}" Click="OnRemoveCampaignClick"
                                                        ToolTip="Remove from queue" Cursor="Hand"
                                                        Width="24" Height="24" Padding="0" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="5" Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="×" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>

                                                <!-- SELECTED / ACTIVE badge -->
                                                <Border Grid.Column="3" VerticalAlignment="Center" Padding="8,3" Margin="6,0,0,0" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"       Value="SELECTED"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Text"       Value="ACTIVE"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- Rewards list -->
                                            <ItemsControl ItemsSource="{Binding Rewards}" Margin="34,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"       Value="·"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsClaimed}" Value="True">
                                                                                <Setter Property="Text"       Value="✓"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsClaimed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Claimed" FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                                                                           Visibility="{Binding IsClaimed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsClaimed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0} / {1} min">
                                                                            <Binding Path="ProgressMinutes"/>
                                                                            <Binding Path="RequiredMinutes"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- COMPLETED section header -->
                    <Button Click="OnToggleCompletedSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="0" BorderThickness="0" Margin="0,12,0,8" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompletedExpanded}" Value="True">
                                                                <Setter Property="Text" Value="▼"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="COMPLETED ({0})">
                                                        <Binding Path="CompletedCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource BorderBrush}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- COMPLETED items -->
                    <ItemsControl ItemsSource="{Binding CompletedItems}"
                                  Visibility="{Binding IsCompletedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" CornerRadius="10" Opacity="0.55"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid Margin="14,10,14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TwitchBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Platform}" Value="Kick">
                                                                <Setter Property="Fill" Value="{DynamicResource KickBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Border Width="26" Height="34" CornerRadius="4" ClipToBounds="True"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    Visibility="{Binding GameImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Image local:ImageEx.SourceUrl="{Binding GameImageUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GameName}" FontSize="11" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" Margin="8,0,0,0"
                                                CornerRadius="6" Background="Transparent">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Done" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding CompletedAtText}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                                           Visibility="{Binding CompletedAtText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
