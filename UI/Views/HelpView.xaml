<UserControl x:Class="UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{DynamicResource MainBackgroundBrush}">

    <UserControl.Resources>
        <!-- NEON HYPERLINK - THE ACCENT IS NOW DYNAMIC -->
        <Style x:Key="NeonHyperlink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECTION TITLE - ACCENT GLOW -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- BODY TEXT - CLEAN & READABLE -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Help &amp; Support"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                <!-- GETTING STARTED -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,32"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Getting Started" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Text="1. Log in to your Twitch &amp; Kick accounts to enable drops tracking." 
                                 Foreground="{DynamicResource AccentBrush}"/><LineBreak/>
                            <Run Text="2. Head to the Dashboard to watch your miner status and campaign progress in real time." 
                                 Foreground="{DynamicResource TextMutedBrush}"/><LineBreak/>
                            <Run Text="3. Use the sidebar to switch between Inventory, Settings, and this Help page." 
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- INVENTORY -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,32"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Inventory Tracking" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource BodyText}">
                            All active campaigns and collected drops are displayed here with live progress per streamer.<LineBreak/>
                            Make sure your accounts are linked - rewards update automatically when claimed.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- SETTINGS -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,32"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource BodyText}">
                            Customize auto-claim, notifications, theme, and more.<LineBreak/>
                            All changes are saved instantly - no "Apply" button needed.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- BROWSER EXTENSION -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="28" Margin="0,0,0,32"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Browser Extension (Optional)" Style="{StaticResource SectionTitle}"/>
                        <Border Background="#332A1F00" BorderBrush="Gold" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="Gold" TextWrapping="Wrap">
                                ⚠ Still in progress - may not work as expected.
                            </TextBlock>
                        </Border>
                        <TextBlock Style="{StaticResource BodyText}">
                            A companion Chrome extension that automatically claims Drops, Moments, and Channel Points bonuses while you browse Twitch directly - separate from this app, not a replacement for it. It's hosted in a private repo, so downloading it will prompt a GitHub login.
                        </TextBlock>
                        <TextBlock FontSize="16">
                            <Hyperlink Style="{StaticResource NeonHyperlink}"
                                       NavigateUri="https://github.com/Scuttle-ZapAccess/automatic-twitch-ext-fork/releases/latest"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                Download the Browser Extension &#8594;
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- SUPPORT & COMMUNITY -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12" Padding="28"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Support" Style="{StaticResource SectionTitle}"/>
                        <TextBlock FontSize="15"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap">
                            Found a bug? Need help? Open an issue on GitHub.
                        </TextBlock>

                        <!-- GITHUB -->
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                                  Fill="{DynamicResource AccentBrush}" Width="25" Height="25" Margin="0,0,12,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">
                                <Hyperlink Style="{StaticResource NeonHyperlink}"
                                           NavigateUri="https://github.com/Scuttle-ZapAccess/StreamDropCollector"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    GitHub Repository
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>