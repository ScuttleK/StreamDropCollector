<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         DARK THEME — Kiloverse navy-dark palette
         Deep navy background, dark navy cards, purple accent
         ============================================================ -->

    <!-- Legacy brush keys (consumed by Views + MainWindow) -->
    <SolidColorBrush x:Key="MainBackgroundBrush"                      Color="#FF0C0E14"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"                      Color="#FF111420"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"                    Color="#FF0C0E14"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"                         Color="#FFECEEF1"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"                       Color="#FFA0A6B0"/>
    <SolidColorBrush x:Key="TextMutedBrush"                           Color="#FF6C7480"/>
    <SolidColorBrush x:Key="BorderBrush"                              Color="#FF242840"/>
    <SolidColorBrush x:Key="HoverBrush"                               Color="#FF191D2E"/>
    <SolidColorBrush x:Key="PressedBrush"                             Color="#FF1D2135"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"                        Color="#FF191D2E"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush"                 Color="#FF191D2E"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedBackground"          Color="#FF7B6CF6"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedForeground"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedHoverBackground"     Color="#FF8C7FFF"/>

    <!-- Semantic brush keys -->
    <SolidColorBrush x:Key="BgBrush"            Color="#FF0C0E14"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FF111420"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#FF191D2E"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush"  Color="#FF1D2135"/>
    <SolidColorBrush x:Key="StrokeBrush"        Color="#FF242840"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#FF7B6CF6"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#FF8C7FFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF6A5BE0"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#FF3FB454"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFE5534B"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#FF8C7FFF"/>

    <!-- Color resources (legacy compat) -->
    <Color x:Key="AccentColor">#FF7B6CF6</Color>
    <Color x:Key="SecondaryAccentColor">#FF8C7FFF</Color>
    <Color x:Key="TextPrimaryColor">#FFECEEF1</Color>
    <Color x:Key="CardBackgroundColor">#FF111420</Color>

</ResourceDictionary>
