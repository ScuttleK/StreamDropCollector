<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         LIGHT THEME — clean neutrals, same purple accent
         ============================================================ -->

    <!-- Legacy brush keys -->
    <SolidColorBrush x:Key="MainBackgroundBrush"                      Color="#FAFAFA"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"                      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"                    Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"                         Color="#121212"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"                       Color="#424242"/>
    <SolidColorBrush x:Key="TextMutedBrush"                           Color="#666666"/>
    <SolidColorBrush x:Key="BorderBrush"                              Color="#E0E0E0"/>
    <SolidColorBrush x:Key="HoverBrush"                               Color="#EBEBF0"/>
    <SolidColorBrush x:Key="PressedBrush"                             Color="#DCDCE4"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"                        Color="#EBEBF0"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush"                 Color="#DCDCDC"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedBackground"          Color="#FF7B6CF6"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedForeground"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedHoverBackground"     Color="#FF8C7FFF"/>

    <!-- Semantic brush keys -->
    <SolidColorBrush x:Key="BgBrush"            Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#EBEBF0"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush"  Color="#DCDCE4"/>
    <SolidColorBrush x:Key="StrokeBrush"        Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#FF7B6CF6"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#FF8C7FFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF6A5BE0"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#FF3FB454"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFE5534B"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#FF8C7FFF"/>

    <!-- Color resources (legacy compat) -->
    <Color x:Key="AccentColor">#FF7B6CF6</Color>
    <Color x:Key="SecondaryAccentColor">#FF8C7FFF</Color>
    <Color x:Key="TextPrimaryColor">#121212</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

</ResourceDictionary>
