<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== PLATFORM COLORS ===================== -->
    <Color x:Key="TwitchPurple">#FF9146FF</Color>
    <Color x:Key="KickGreen">#FF53FC18</Color>
    <SolidColorBrush x:Key="TwitchBrush" Color="{StaticResource TwitchPurple}"/>
    <SolidColorBrush x:Key="KickBrush"   Color="{StaticResource KickGreen}"/>

    <!-- ===================== DESIGN TOKENS (static, theme-agnostic) ===================== -->
    <Color x:Key="C.Bg">#FF0D0E11</Color>
    <Color x:Key="C.Surface">#FF15171C</Color>
    <Color x:Key="C.SurfaceHover">#FF1C1F26</Color>
    <Color x:Key="C.SurfaceMuted">#FF20242C</Color>
    <Color x:Key="C.Stroke">#FF2A2F38</Color>
    <Color x:Key="C.TextPrimary">#FFECEEF1</Color>
    <Color x:Key="C.TextSecondary">#FFA0A6B0</Color>
    <Color x:Key="C.TextMuted">#FF6C7480</Color>
    <Color x:Key="C.Accent">#FF7B6CF6</Color>
    <Color x:Key="C.AccentHover">#FF8C7FFF</Color>
    <Color x:Key="C.AccentPressed">#FF6A5BE0</Color>
    <Color x:Key="C.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="C.Success">#FF3FB454</Color>
    <Color x:Key="C.Danger">#FFE5534B</Color>

    <!-- ===================== TYPOGRAPHY ===================== -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, Inter, sans-serif</FontFamily>

    <!-- ===================== PLACEHOLDER BRUSHES — overridden by Dark / Light ===================== -->
    <!-- Legacy keys consumed by Views and MainWindow -->
    <SolidColorBrush x:Key="MainBackgroundBrush"                      Color="#FF0D0E11"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"                      Color="#FF15171C"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"                    Color="#FF15171C"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"                         Color="#FFECEEF1"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"                       Color="#FFA0A6B0"/>
    <SolidColorBrush x:Key="TextMutedBrush"                           Color="#FF6C7480"/>
    <SolidColorBrush x:Key="BorderBrush"                              Color="#FF2A2F38"/>
    <SolidColorBrush x:Key="HoverBrush"                               Color="#FF1C1F26"/>
    <SolidColorBrush x:Key="PressedBrush"                             Color="#FF20242C"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"                        Color="#FF1C1F26"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush"                 Color="#FF1C1F26"/>
    <SolidColorBrush x:Key="AccentBrush"                              Color="#FF7B6CF6"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush"                     Color="#FF8C7FFF"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedBackground"          Color="#FF7B6CF6"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedForeground"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxItem.SelectedHoverBackground"     Color="#FF8C7FFF"/>
    <!-- New semantic brush keys -->
    <SolidColorBrush x:Key="BgBrush"            Color="#FF0D0E11"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FF15171C"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#FF1C1F26"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush"  Color="#FF20242C"/>
    <SolidColorBrush x:Key="StrokeBrush"        Color="#FF2A2F38"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#FF8C7FFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF6A5BE0"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#FF3FB454"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFE5534B"/>
    <!-- Color resources (legacy compat) -->
    <Color x:Key="AccentColor">#FF7B6CF6</Color>
    <Color x:Key="SecondaryAccentColor">#FF8C7FFF</Color>
    <Color x:Key="TextPrimaryColor">#FFECEEF1</Color>
    <Color x:Key="CardBackgroundColor">#FF15171C</Color>

    <!-- ===================== TYPOGRAPHY STYLES ===================== -->
    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- ===================== CARD (Border) ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"     Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush"    Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"   Value="14"/>
        <Setter Property="Padding"        Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== BUTTONS ===================== -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="FontFamily"  Value="{StaticResource UiFont}"/>
        <Setter Property="Background"  Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Padding"     Value="18,10"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="FontFamily"  Value="{StaticResource UiFont}"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Padding"     Value="18,10"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== PROGRESS BAR (implicit — applies globally) ===================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"           Value="8"/>
        <Setter Property="Foreground"       Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"       Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4"
                                Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="4"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TEXTBOX ===================== -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontFamily"     Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground"     Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush"     Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"     Value="{DynamicResource BgBrush}"/>
        <Setter Property="FontSize"       Value="13"/>
        <Setter Property="Padding"        Value="12,9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CHECKBOX ===================== -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tick" Width="10" Height="10" Stretch="Uniform"
                                  Data="M2,6 L5,9 L10,2"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background"   Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="tick" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== SLIM SCROLLBAR (implicit — applies globally) ===================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width"      Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="5" Margin="2,0"
                                                    Background="{DynamicResource SurfaceMutedBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"  Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
